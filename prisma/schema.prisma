generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"

}

datasource db {
  provider = "postgresql"
}

enum SessionState {
  IDLE
  WAITING_AMOUNT
  WAITING_TYPE
  WAITING_CATEGORY
  WAITING_DESCRIPTION
  WAITING_BUDGET
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(uuid())
  telegramId   String        @unique
  username     String?
  firstName    String?
  lastName     String?
  monthlyBudget Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[] @relation("UserTransactions")
  session      BotSession?   @relation("UserSession")
}

model BotSession {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation("UserSession", fields: [userId], references: [id], onDelete: Cascade)
  currentState      SessionState  @default(IDLE)
  tempAmount        Int?
  tempType          TransactionType?
  tempCategory      String?
  lastTransactionId String?
  updatedAt         DateTime      @updatedAt
}

model Transaction {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        TransactionType
  category    String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  reversedAt  DateTime?

  @@index([userId, createdAt])
  @@index([userId, reversedAt])
}
