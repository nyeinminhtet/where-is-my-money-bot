# ------------------------------------------------------------------
# Where Is My Money Bot — Environment Variables
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# Never commit real secrets to the repository (.env* is git-ignored).

# --- Database (Supabase PostgreSQL) ---
# DATABASE_URL: use the Supabase pooler URL for runtime queries.
# DIRECT_URL: use the direct PostgreSQL URL for Prisma migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- App ---
# Public site URL (used as metadataBase / Mini App link).
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# --- Telegram ---
# Bot token issued by @BotFather.
TELEGRAM_BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxx"
# Optional override (defaults to https://api.telegram.org).
TELEGRAM_API_URL="https://api.telegram.org"
# Telegram user id granted unlimited AI quota (admin).
ADMIN_TELEGRAM_ID="0"

# --- Gemini AI ---
# API key from Google AI Studio.
GEMINI_API_KEY=""
# Optional model override (defaults to gemini-3.1-flash-lite).
GEMINI_MODEL="gemini-3.1-flash-lite"
# Optional proxy URL to route Gemini requests through (e.g. a worker).
GEMINI_PROXY_URL=""

# --- Cron ---
# Shared secret used to authorize the daily reminder cron route.
CRON_SECRET=""
